# VideoFetcher Configuration Example
# Copy this file to .env and customize as needed. Never commit .env to version control.

# Debug mode (true/false)
DEBUG=false

# Temporary download directory (default: ./temp_downloads)
TEMP_DIR=

# Path to custom FFmpeg binary (optional, auto-detected from PATH if left empty)
FFMPEG_PATH=

# Max allowed download size in MB
MAX_FILE_SIZE_MB=300

# Allowed CORS origins (comma-separated, default: *)
ALLOWED_ORIGINS=*

# Default User-Agent for media extraction
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
