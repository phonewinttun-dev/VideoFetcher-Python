# VideoFetcher Configuration Example
# Copy this file to .env and customize as needed. Never commit .env to version control.

# Debug mode (true/false)
DEBUG=false

# Temporary download directory (default: ./temp_downloads)
TEMP_DIR=

# Path to custom FFmpeg binary (optional, auto-detected from PATH if left empty)
FFMPEG_PATH=

# Max allowed download size in MB
MAX_FILE_SIZE_MB=300

# Allowed CORS origins (comma-separated, default: *)
ALLOWED_ORIGINS=*

# Proxy for routing requests around datacenter IP blocking on cloud platforms (e.g. Render / AWS)
# Format: http://user:pass@host:port or socks5://host:port
PROXY=

# Server-wide Netscape cookies text for YouTube extraction (paste full Netscape cookie text)
YOUTUBE_COOKIES=

# Path to cookies.txt file (optional alternative to YOUTUBE_COOKIES)
COOKIES_FILE=

# YouTube Innertube client fallback sequence (comma-separated, android avoids web SABR format stripping)
YOUTUBE_PLAYER_CLIENTS=android,web,web_safari

# Custom User-Agent (leave empty for yt-dlp per-client auto-management)
DEFAULT_USER_AGENT=
