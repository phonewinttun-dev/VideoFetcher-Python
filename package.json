{
  "name": "videofetcher-client",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CLI build configuration for VideoFetcher client assets",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i app/static/css/input.css -o app/static/css/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i app/static/css/input.css -o app/static/css/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
